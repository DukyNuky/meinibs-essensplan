# Zugangsdaten für meinibs.de (Kunden-Nr./Login + Passwort deines Bestell-Accounts).
# Diese Datei als .env kopieren und ausfüllen - .env NIEMALS committen.
MEINIBS_BASE_URL=https://meinibs.de/skitbs-rest/rest/skitbs_mobile/v1
MEINIBS_USER=
MEINIBS_PASSWORD=

# Wie oft automatisch synchronisiert wird (Cron-Syntax). Default: alle 4 Stunden.
SYNC_CRON=0 */4 * * *

# Wie viele Wochen rückwirkend / im Voraus bei jedem Sync abgeholt werden.
SYNC_WEEKS_BACK=8
SYNC_WEEKS_FORWARD=2

PORT=3000
# Port, unter dem die App auf dem Host erreichbar ist (nur für docker-compose -
# links vom ":" in "HOST_PORT:PORT"). Ändern, falls 3000 schon belegt ist.
HOST_PORT=3000
DB_PATH=./data/meinibis.db
